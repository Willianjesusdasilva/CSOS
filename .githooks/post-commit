#!/bin/sh

# Notify the project owner after each commit. Notification failures must not
# make an otherwise successful commit fail.
repo_root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
toast_script="$repo_root/toast.py"
[ -f "$toast_script" ] || exit 0

commit=$(git log -1 --pretty=format:'%h')
subject=$(git log -1 --pretty=format:'%s')
count=$(git rev-list --count HEAD)
files=$(git diff-tree --no-commit-id --name-status -r HEAD | sed 's/^/  /')
next_step="Concluir o build WPE/WebKit e validar WPEWebProcess no CSOS"
message="Commitado:\n$files\n\nProximo passo:\n$next_step\n\nTotal de commits: $count"

python "$toast_script" --message "$message" --title "$subject" \
  --topic "willian-toast-7f29d1" >/dev/null 2>&1 || true

exit 0
